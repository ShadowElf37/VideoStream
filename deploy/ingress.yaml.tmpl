# livekit-ingress config TEMPLATE (optional `ingress` profile).
#
# Rendered to ./ingress.yaml by oracle-setup.sh:
#   envsubst '${LIVEKIT_API_KEY} ${LIVEKIT_API_SECRET}' \
#     < ingress.yaml.tmpl > ingress.yaml
# The container is pointed at it with INGRESS_CONFIG_FILE=/etc/ingress.yaml.
#
# Only needed for WHIP/RTMP publishing (OBS screen share from Linux). The
# projector does not use it. Start with:
#   docker compose --profile ingress up -d

# Same key pair as livekit.yaml — ingress authenticates to the SFU as a service.
api_key: ${LIVEKIT_API_KEY}
api_secret: ${LIVEKIT_API_SECRET}

# Plain ws:// on loopback: ingress runs on the host network next to the SFU, so
# this connection never leaves the machine and needs no TLS.
ws_url: ws://localhost:7880

# Ingress requires Redis (it uses it for service discovery / job dispatch with
# livekit-server). The redis service in the ingress profile binds 127.0.0.1 only.
redis:
  address: localhost:6379

# WHIP (WebRTC-HTTP ingest) endpoint. Proxied by Caddy at /whip* — see the
# commented block in the Caddyfile. Note the upstream default is 8080, which
# would collide with our app server; 8085 keeps them apart.
whip_port: 8085

# Internal HTTP relay between the ingress handler subprocesses and the service.
# Loopback only; do not expose it.
http_relay_port: 9090

# RTMP ingest (OBS "Custom..." server rtmp://<your domain>:1935/x). Uncomment and
# open TCP 1935 in the VCN + iptables if you want RTMP as well as WHIP.
# rtmp_port: 1935

rtc_config:
  # WebRTC media port for WHIP sessions. Documented default is 7885; a single
  # mux port, same rationale as livekit's rtc.udp_port. Open UDP 7885.
  udp_port: 7885
  # NOTE: PLAN.md mentions a 7885–7895 *range*. The published ingress config
  # reference documents only `tcp_port`, `udp_port` and `use_external_ip` under
  # rtc_config — no `port_range_start`/`port_range_end` — so this stays a single
  # port. If a future version documents a range, widen it here and open UDP
  # 7885:7895 in the VCN + iptables to match. (Uncertain: unverified against the
  # running image; check `docker compose --profile ingress logs ingress` for
  # config parse errors after any change here.)
  use_external_ip: true

logging:
  level: info
