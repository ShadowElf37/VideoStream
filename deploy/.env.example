# VideoStream deployment environment.
#
# Copy to .env and fill in, or just run ./oracle-setup.sh, which creates .env
# interactively (prompting for DOMAIN and PUBLIC_IP, generating the secrets).
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored. Anything in here that leaks lets a stranger mint LiveKit
# tokens and join your rooms.
#
# Values are read by docker compose (variable substitution in
# docker-compose.yml), by the app container (env_file), and by oracle-setup.sh
# when it renders livekit.yaml / ingress.yaml with envsubst. Keep them free of
# quotes, spaces and `#`, since compose's .env parser is not a shell.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Public hostname of the party. An A record for this name AND for
# turn.<this name> must point at PUBLIC_IP before Caddy can get certificates.
# No scheme, no trailing slash. With no domain of your own,
# <public-ip>.sslip.io works (then TURN is turn.<public-ip>.sslip.io).
DOMAIN=watch.example.com

# The instance's *reserved* public IP. Oracle 1:1-NATs it onto the private NIC
# address, so LiveKit cannot discover it from the interface — it is pinned into
# livekit.yaml as rtc.node_ip. Re-render livekit.yaml after changing it.
PUBLIC_IP=203.0.113.10

# LiveKit API credentials. The app server signs join tokens with them and
# livekit-server verifies them (keys: block in livekit.yaml). Generated by
# oracle-setup.sh as "API" + 12 random alphanumerics / 32 url-safe characters.
# Changing them means re-rendering livekit.yaml and restarting livekit + app.
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=replace-me-with-32-random-characters

# HMAC key for the app server's opaque `session` strings (see proto/README.md).
# Rotating it invalidates every issued session; people just rejoin.
SESSION_SECRET=replace-me-with-32-random-characters

# ---------------------------------------------------------------------------
# Set for you by docker-compose.yml — listed here only so you know they exist.
# Overriding them in .env is possible but rarely what you want.
# ---------------------------------------------------------------------------

# SQLite file inside the app container (bind-mounted from ./data).
# DB_PATH=/data/videostream.db

# Address the app server listens on inside its container. Caddy proxies to
# app:8080; the port is never published to the host.
# LISTEN=:8080

# Base URL used to build invite / host / projector links.
# PUBLIC_URL=https://watch.example.com

# WebSocket URL handed to browsers in the token response. Caddy proxies /rtc*
# to LiveKit, so it is the same origin as the app.
# LIVEKIT_URL=wss://watch.example.com

# Where the app server's own Twirp calls (CreateRoom, SendData) go: straight to
# livekit-server on the host network, bypassing TLS and the proxy.
# LIVEKIT_API_URL=http://host.docker.internal:7880

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Contact address for Let's Encrypt expiry notices. To use it, uncomment the
# `email {$ACME_EMAIL}` line in the Caddyfile and pass ACME_EMAIL through in the
# caddy service's `environment:` block.
# ACME_EMAIL=you@example.com
